<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/signal_empty_state_horizontal_margin"
    android:paddingEnd="@dimen/signal_empty_state_horizontal_margin"
    tools:viewBindingIgnore="true">

    <FrameLayout
        android:layout_width="@dimen/signal_empty_state_icon_size"
        android:layout_height="@dimen/signal_empty_state_icon_size"
        android:background="@drawable/conversation_list_empty_icon_background"
        android:contentDescription="@null">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_search_24"
            app:tint="@color/signal_colorOnSurfaceVariant" />
    </FrameLayout>

    <!-- Bound by ConversationListSearchModels.EmptyViewHolder -->
    <TextView
        android:id="@+id/search_no_results"
        style="@style/Signal.Text.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/signal_colorOnSurface"
        tools:text="@string/SearchFragment_no_results" />

    <TextView
        style="@style/Signal.Text.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/conversation_list_empty_search__try_a_different_name_or_number"
        android:textColor="@color/signal_colorOnSurfaceVariant" />

</LinearLayout>
