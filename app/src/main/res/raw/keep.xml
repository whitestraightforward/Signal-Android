<?xml version="1.0" encoding="utf-8"?>
<!--
  Resource shrinker keep rules only (no runtime effect).
  Raw TLS stores, ringtones, Lottie, fonts, and launcher mipmaps must stay.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/*,@font/*,@mipmap/ic_launcher*"
    tools:shrinkMode="safe" />
